@swap bex_2h player_2h rc RC xt
@swap bex_punch player_punch rc RC xt
@swap bex_down player_down rc RC xt B5 d4 D3
@swap bex_dead hollis_dead zc JC jt B5 d4 D3
@swap legs_bex legs_player B5 d4 D3

@swap ozzie_idle player_idle rw RW xN sk SK
@swap ozzie_1h player_1h rw RW xN sk SK
@swap ozzie_2h player_2h rw RW xN sk SK
@swap ozzie_punch player_punch rw RW xN sk SK
@swap ozzie_down player_down rw RW xN sk SK BA da D2
@swap ozzie_dead hollis_dead zw JW jN sk SK BA da D2
@swap legs_ozzie legs_player BA da D2

@swap carmen_idle player_idle r7 R5 x4
@swap carmen_1h player_1h r7 R5 x4
@swap carmen_2h player_2h r7 R5 x4
@swap carmen_punch player_punch r7 R5 x4
@swap carmen_down player_down r7 R5 x4
