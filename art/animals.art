# coats, and the rabid ones: mangy, red-eyed, foaming at the mouth
@swap dog2_walk dog_walk w5 W4 N3 LB
@swap dog2_bite dog_bite w5 W4 N3 LB
@swap dog2_rest dog_rest w5 W4 N3 LB
@swap dog2_dead dog_dead w5 W4 N3 LB

@swap dog3_walk dog_walk wh WH Nf LG
@swap dog3_bite dog_bite wh WH Nf LG
@swap dog3_rest dog_rest wh WH Nf LG
@swap dog3_dead dog_dead wh WH Nf LG

@swap dogr_walk dog_walk wf WM N2 2r 38 Lx
@swap dogr_bite dog_bite wf WM N2 2r 38 Lx
@swap dogr_rest dog_rest wf WM N2 2r 38 Lx
@swap dogr_dead dog_dead wf WM N2 2r 38 Lx

@swap cat2_walk cat_walk o6 O5 n4
@swap cat2_bite cat_bite o6 O5 n4
@swap cat2_rest cat_rest o6 O5 n4
@swap cat2_dead cat_dead o6 O5 n4

@swap cat3_walk cat_walk o3 O2 n1 2g
@swap cat3_bite cat_bite o3 O2 n1 2g
@swap cat3_rest cat_rest o3 O2 n1 2g
@swap cat3_dead cat_dead o3 O2 n1 2g

@swap catr_walk cat_walk of OM n2 2r P8
@swap catr_bite cat_bite of OM n2 2r P8
@swap catr_rest cat_rest of OM n2 2r P8
@swap catr_dead cat_dead of OM n2 2r P8

@swap foxr_walk fox_walk oF OM F2 7e 2r 38
@swap foxr_bite fox_bite oF OM F2 7e 2r 38
@swap foxr_rest fox_rest oF OM F2 7e 2r 38
@swap foxr_dead fox_dead oF OM F2 7e 2r 38

@swap ratr_walk rat_walk ef fM M2 2r P8
@swap ratr_bite rat_bite ef fM M2 2r P8
@swap ratr_rest rat_rest ef fM M2 2r P8
@swap ratr_dead rat_dead ef fM M2 2r P8
